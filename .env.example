# Copia este archivo a `.env` y rellena los valores de tu proyecto Supabase.
# Ambas variables son obligatorias: sin ellas la app arranca pero avisa en pantalla.
# Están en Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional. A 'true' la app pide acceso con usuario y contraseña de Supabase Auth.
# Enciéndelo SOLO después de ejecutar supabase/auth.sql: si no, pedirá credenciales
# contra una base que no las usa y no verás tus datos.
# NEXT_PUBLIC_AUTH_REQUERIDO=true
